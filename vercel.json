{
  "regions": [
    "fra1"
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/game?cron=1",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/game?cron=1&slot=midi",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/game?cron=1&slot=soir",
      "schedule": "0 17 * * *"
    }
  ]
}
